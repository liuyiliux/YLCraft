{
  "schema_version": 1,
  "name": "OpenAI GPT Image-2 Edit（图生图协议示例）",
  "description": "OpenAI Images Edits 协议示例，不绑定任何第三方中转站。请将 Base URL、认证方式和具体模型替换为你信任且已确认的供应商。支持 multipart 单图/多图参考。",
  "connectors": [
    {
      "id": "chybenzun-gpt-image-2-edit",
      "provider": "openai",
      "name": "OpenAI GPT Image-2 Edit（通用示例）",
      "api_key": "",
      "provider_type": "image",
      "base_url": "https://api.example.com/v1",
      "api_endpoint": "/images/edits",
      "default_model": "gpt-image-2",
      "available_models": ["gpt-image-2"],
      "supported_sizes": [
        "1024x1024",
        "1536x1024",
        "1024x1536",
        "2048x2048",
        "2048x1152",
        "1152x2048",
        "3840x2160",
        "2160x3840"
      ],
      "request_template": "{\"model\":\"{{ model }}\",\"prompt\":{{ prompt_json }},\"size\":\"{{ size }}\",\"n\":1,\"quality\":\"{{ quality | default('auto') }}\",\"response_format\":\"b64_json\"}",
      "response_config": {
        "images_path": "$.data[*].url",
        "base64_images_path": "$.data[*].b64_json",
        "error_path": "$.error.message",
        "response_format": "base64"
      },
      "default_params": {
        "image_capabilities": ["image_to_image"],
        "request_content_type": "multipart",
        "multipart_image_field": "image",
        "n": 1,
        "quality": "auto",
        "response_format": "b64_json"
      },
      "support_reference_image": true,
      "support_multiple_reference_images": true,
      "reference_image_field": "image",
      "is_active": false,
      "is_default": false,
      "priority": 100,
      "description": "OpenAI Images Edits 协议示例：multipart 使用重复的 image 文件字段，JSON 模式使用 images[].image_url。请按实际供应商文档确认 edits 路径、模型名、鉴权和响应格式。仅示例，不包含 API Key。",
      "timeout": 300,
      "test_timeout": 30,
      "api_format": "custom"
    }
  ]
}
