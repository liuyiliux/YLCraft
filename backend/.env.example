# YLCraft 环境变量配置示例
# 复制为 .env 后填入真实 Key

# 豆包 API（LLM + TTS）
DOUBAO_API_KEY=your_doubao_api_key_here

# MiniMax API（图生视频）
MINIMAX_API_KEY=your_minimax_api_key_here

# （可选）抖音 Cookie（用于高清/私密内容解析）
# DOUYIN_COOKIE=session_id=xxx; sessionid=xxx

# （可选）B站 Cookie
# BILIBILI_COOKIE=SESSDATA=xxx; bili_jct=xxx
