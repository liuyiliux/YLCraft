# YLCraft 环境变量配置示例
# 复制为 .env 后填入真实值

# 数据库（必须）
DATABASE_URL=postgresql+asyncpg://ylcraft:ylcraft_dev@localhost:5432/ylcraft
REDIS_URL=redis://localhost:6379

# （可选）Hugging Face API（仅 Live2D 分割功能使用）
# HUGGINGFACE_API_KEY=your_hf_api_key_here

# （可选）磁力/种子下载
# 默认使用 qBittorrent Web UI。需要在 qBittorrent 设置中启用 Web UI，
# 并确认这里的 URL 是 qBittorrent 的 Web UI 地址，不是项目或其它服务端口。
# TORRENT_ENGINE=qbittorrent
# QBITTORRENT_URL=http://127.0.0.1:8080
# QBITTORRENT_USERNAME=admin
# QBITTORRENT_PASSWORD=adminadmin
# TORRENT_DOWNLOAD_DIR=./downloads/torrents

# 如不想安装/运行 qBittorrent，可尝试 libtorrent Python bindings：
# 先安装：pip install -r requirements-torrent.txt
# TORRENT_ENGINE=libtorrent
