{
  "plugins": [
    [
      "babel-plugin-import",
      {
        "libraryName": "antd",
        "libraryDirectory": "es",
        "style": false
      }
    ],
    [
      "babel-plugin-import",
      {
        "libraryName": "@ant-design/icons",
        "libraryDirectory": "icons",
        "camel2DashComponentName": false
      }
    ]
  ]
}